{
  "name": "impeller-v07-parameter-sweep",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "python scripts/build_sweep_data.py",
    "check": "npx --yes hyperframes@0.7.21 lint && npx --yes hyperframes@0.7.21 validate && npx --yes hyperframes@0.7.21 inspect",
    "render": "npx --yes hyperframes@0.7.21 render --fps 60 --quality high --output renders/impeller-v07-parameter-sweep.mp4",
    "render:draft": "npx --yes hyperframes@0.7.21 render --fps 60 --quality draft --output renders/impeller-v07-parameter-sweep-draft.mp4",
    "preview": "npx --yes hyperframes@0.7.21 preview --port 3027"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.14.2",
    "three": "^0.172.0"
  }
}
