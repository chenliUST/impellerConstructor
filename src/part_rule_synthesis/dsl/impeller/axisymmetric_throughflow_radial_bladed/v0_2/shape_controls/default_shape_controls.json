    "tip_closure_or_shroud_join_surface": {
      "target_entity": "tip_closure_or_shroud_join_surface",
      "representation": "nurbs_surface_uv_xyz",
      "representation_topology": {
        "degree": 2,
        "control_point_count": 9,
