{
  "dsl_version": "0.3",
  "supersedes": "../v0_2/constructors/open_impeller.json",
  "constructor_id": "axisymmetric_throughflow_radial_bladed.open.v0_3",
  "constructor_family": "AxisymmetricThroughflowRadialBladedImpeller",
  "classification": {
    "part_family": "impeller",
    "flow_topology": "radial",
    "passage_topology": "throughflow_bladed_channel",
    "shroud_topology": "open",
    "entry_topology": "single_entry",
    "suction_topology": "single_suction",
    "blade_exit_geometry": "backward_curved",
    "blade_population": "full_blade_set",
    "working_domain": "pump"
  },
  "coordinate_system": {
    "units": "mm",
    "frame": "cylindrical",
    "rotation_axis": "z",
    "positive_rotation": "counterclockwise_viewed_from_inlet"
  },
  "main_dimensions": {
    "required_parameters": [
      "blade_count",
      "inlet_radius_mm",
      "exit_radius_mm",
      "inlet_blade_height_mm",
      "outlet_blade_height_mm",
      "mounting_bore_radius_mm",
      "hub_wall_thickness_mm",
      "hub_bottom_thickness_mm",
      "hub_top_cap_thickness_mm",
      "hub_chamfer_radius_mm"
    ]
  },
  "primary_flow_path": {
    "hub_meridional_profile": "hub_meridional_profile",
    "blade_tip_meridional_profile": "blade_tip_meridional_profile",
    "blade_tip_meridional_profile_use": "construction_support_only",
    "inlet_flow_path_boundary": "leading_edge_boundary",
    "outlet_flow_path_boundary": "trailing_edge_boundary"
  },
  "support_surfaces": {
    "hub_support_surface": {
      "kind": "revolved_nurbs_surface",
      "source_profile": "hub_meridional_profile",
      "material": true,
      "display": "visible"
    },
    "blade_tip_support_surface": {
      "kind": "revolved_nurbs_surface",
      "source_profile": "blade_tip_meridional_profile",
      "role": "construction_support_only",
      "material": false,
      "display": "hidden_by_default"
    }
  },
  "shape_control": {
    "shape_control_ref": "shape_controls/default_shape_controls.json",
    "optimization_stage": 2,
    "target_entities": [
      "hub_meridional_profile",
      "blade_tip_meridional_profile",
      "leading_edge_boundary",
      "trailing_edge_boundary",
      "blade_mean_surface",
      "blade_thickness_distribution",
      "hub_material_solid",
      "hub_chamfer_features"
    ]
  },
  "material_domain": {
    "hub": {
      "kind": "capped_revolved_solid_with_bore",
      "functional_surface": "hub_support_surface",
      "requires_back_face": true,
      "requires_top_cap_face": true,
      "requires_bottom_thickness": true,
      "requires_mounting_bore": true,
      "wall_thickness_parameter": "hub_wall_thickness_mm",
      "bottom_thickness_parameter": "hub_bottom_thickness_mm",
      "top_cap_thickness_parameter": "hub_top_cap_thickness_mm",
      "bore_parameter": "mounting_bore_radius_mm"
    },
    "front_shroud": {
      "kind": "none"
    }
  },
  "blade_pattern": {
    "kind": "circular_pattern",
    "count_parameter": "blade_count",
    "axis": "rotation_axis"
  },
  "blade_boundaries": {
    "root": {
      "id": "blade_root_boundary",
      "support_surface": "hub_support_surface",
      "parameter": "v=0"
    },
    "tip": {
      "id": "blade_tip_boundary",
      "support_surface": "blade_tip_support_surface",
      "support_surface_visibility": "construction_only",
      "parameter": "v=1"
    },
    "leading_edge": {
      "id": "leading_edge_boundary",
      "kind": "spanwise_nurbs_curve",
      "parameter": "u=0"
    },
    "trailing_edge": {
      "id": "trailing_edge_boundary",
      "kind": "spanwise_nurbs_curve",
      "parameter": "u=1"
    }
  },
  "blade_surface_construction": {
    "kind": "nurbs_coons_with_internal_controls",
    "boundary_contract": "four_boundary_curves_required",
    "internal_shape_controls": {
      "theta_law": "beta_integral_or_intrinsic_curve_override",
      "wrap_angle": "parameterized",
      "camber_control_points": "parameterized",
      "spanwise_twist_law": "parameterized"
    }
  },
  "blade_profile": {
    "thickness_field": "blade_thickness_distribution",
    "pressure_surface": "offset_from_mean_surface",
    "suction_surface": "offset_from_mean_surface"
  },
  "blade_edges": {
    "leading_edge": {
      "kind": "ellipse_or_rounded_nurbs_patch"
    },
    "trailing_edge": {
      "kind": "ellipse_or_rounded_nurbs_patch"
    },
    "root": {
      "kind": "fillet_patch"
    },
    "tip": {
      "kind": "exposed_closed_edge"
    }
  },
  "solid_features": {
    "hub_bore": {
      "kind": "cylindrical_cut",
      "axis": "rotation_axis",
      "radius_parameter": "mounting_bore_radius_mm",
      "extent": "through_hub_solid"
    },
    "hub_chamfers": {
      "kind": "chamfer_or_fillet_feature_set",
      "radius_parameter": "hub_chamfer_radius_mm",
      "applies_to": [
        "hub_bottom_outer_edge",
        "hub_top_cap_outer_edge",
        "mounting_bore_top_edge",
        "mounting_bore_bottom_edge"
      ]
    }
  },
  "display_policy": {
    "hide_surfaces": ["blade_tip_support_surface"],
    "show_construction_lines": [
      "hub",
      "blade_boundaries",
      "blade_u",
      "blade_v",
      "blade_edges",
      "surface_uv"
    ]
  },
  "surface_graph": {
    "requires_named_boundary_curves": true,
    "requires_adjacency": true,
    "requires_closed_hub_solid_candidate": true
  },
  "validation": {
    "geometry_contracts": [
      "blade_root_boundary_conforms_to_hub_support_surface",
      "blade_tip_boundary_conforms_to_blade_tip_support_surface",
      "construction_lines_sampled_from_surface_graph",
      "hub_wall_thickness_positive",
      "hub_bottom_thickness_positive"
    ],
    "topology_contracts": [
      "blade_has_four_primary_boundaries",
      "open_impeller_has_no_front_shroud_material",
      "hub_solid_has_top_and_bottom_cap_faces",
      "mounting_bore_is_through_cut",
      "open_tip_support_surface_not_in_display_graph"
    ]
  }
}
