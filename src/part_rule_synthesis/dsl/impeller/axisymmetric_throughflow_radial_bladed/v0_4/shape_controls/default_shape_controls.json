{
  "shape_control_version": "0.4",
  "supersedes": "../../v0_3/shape_controls/default_shape_controls.json",
  "optimization_stage": 2,
  "campaign_freeze_rule": "topology_variables_immutable_inside_campaign",
  "design_space": {
    "topology_variables": [
      "hub_profile.control_point_count",
      "tip_profile.control_point_count",
      "hub_profile.degree",
      "tip_profile.degree",
      "blade_surface.guide_curve_count",
      "blade_surface.spanwise_layer_count",
      "enabled_features"
    ],
    "design_variables": [
      "hub_profile.control_points[*].r_mm",
      "hub_profile.control_points[*].z_mm",
      "tip_profile.control_points[*].r_mm",
      "tip_profile.control_points[*].z_mm",
      "blade_theta_control_points[*].theta_deg",
      "thickness_control_points[*].thickness_mm",
      "leading_edge.sweep_mm",
      "trailing_edge.sweep_mm",
      "root_fillet.radius_mm"
    ],
    "campaign_signature_fields": [
      "topology_variables",
      "design_vector_order",
      "enabled_features",
      "patch_group_ids"
    ]
  },
  "target_entities": [
    "hub_meridional_profile",
    "blade_tip_meridional_profile",
    "leading_edge_boundary",
    "trailing_edge_boundary",
    "blade_mean_surface",
    "blade_thickness_distribution",
    "leading_edge_transition",
    "trailing_edge_transition",
    "root_transition",
    "tip_transition",
    "hub_material_solid",
    "front_hood_shell",
    "hub_chamfer_features",
    "hood_chamfer_features"
  ],
  "topology_defaults": {
    "hub_profile": {
      "degree": 3,
      "control_point_count": 6,
      "knot_policy": "clamped_open_uniform",
      "weight_policy": "unit_locked"
    },
    "tip_profile": {
      "degree": 3,
      "control_point_count": 6,
      "knot_policy": "clamped_open_uniform",
      "weight_policy": "unit_locked"
    },
    "blade_surface": {
      "guide_curve_count": 3,
      "spanwise_layer_count": 4,
      "knot_policy": "clamped_open_uniform"
    }
  },
  "design_variable_bounds": {
    "root_fillet.radius_mm": {
      "units": "mm",
      "min": 0.0,
      "max": 80.0,
      "maps_to_parameter": "root_fillet_radius_mm"
    },
    "blade_theta_control_points[*].theta_deg": {
      "units": "deg",
      "min": -240.0,
      "max": 240.0,
      "maps_to_parameter": "blade_wrap_deg"
    },
    "thickness_control_points[*].thickness_mm": {
      "units": "mm",
      "min": 0.5,
      "max": 120.0,
      "maps_to_parameter": "blade_thickness_mm"
    }
  },
  "material_domain_controls": {
    "hub_material_solid": {
      "control_variables": [
        {
          "id": "hub_wall_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [1.0, 120.0]
        },
        {
          "id": "hub_bottom_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [1.0, 160.0]
        },
        {
          "id": "hub_top_cap_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [1.0, 80.0]
        }
      ],
      "constraints": [
        "hub_wall_thickness_positive",
        "hub_bottom_thickness_positive",
        "hub_top_cap_thickness_positive",
        "mounting_bore_radius_less_than_local_hub_radius"
      ]
    },
    "front_hood_shell": {
      "control_variables": [
        {
          "id": "hood_wall_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [1.0, 80.0]
        }
      ],
      "constraints": [
        "hood_wall_thickness_positive_for_closed_impeller",
        "hood_shell_inner_outer_surfaces_do_not_cross"
      ]
    },
    "hub_chamfer_features": {
      "control_variables": [
        {
          "id": "hub_chamfer_radius_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.0, 30.0]
        }
      ],
      "constraints": [
        "hub_chamfer_radius_nonnegative",
        "hub_chamfer_does_not_remove_blade_root_boundary"
      ]
    },
    "hood_chamfer_features": {
      "control_variables": [
        {
          "id": "hood_chamfer_radius_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.0, 30.0]
        }
      ],
      "constraints": [
        "hood_chamfer_radius_nonnegative",
        "hood_chamfer_does_not_remove_blade_tip_boundary"
      ]
    }
  },
  "carried_forward_from_v0_3": [
    "hub_meridional_profile",
    "blade_tip_meridional_profile",
    "leading_edge_boundary",
    "trailing_edge_boundary",
    "blade_mean_surface",
    "blade_thickness_distribution",
    "leading_edge_transition",
    "trailing_edge_transition",
    "root_transition",
    "tip_transition",
    "hub_material_solid",
    "front_hood_shell"
  ]
}
