{
  "shape_control_version": "0.7",
  "supersedes": "../../v0_6/shape_controls/default_shape_controls.json",
  "optimization_stage": 2,
  "campaign_freeze_rule": "topology_variables_immutable_inside_campaign",
  "design_space": {
    "topology_variables": [
      "hub_profile.control_point_count",
      "tip_profile.control_point_count",
      "hub_profile.degree",
      "tip_profile.degree",
      "blade_surface.guide_curve_count",
      "blade_surface.spanwise_layer_count",
      "enabled_features"
    ],
    "design_variables": [
      "hub_profile.control_points[*].r_mm",
      "hub_profile.control_points[*].z_mm",
      "tip_profile.control_points[*].r_mm",
      "tip_profile.control_points[*].z_mm",
      "blade_theta_control_points[*].theta_deg",
      "thickness_control_points[*].thickness_mm",
      "leading_edge.sweep_mm",
      "trailing_edge.sweep_mm",
      "root_fillet.radius_mm",
      "leading_edge.radius_mm",
      "trailing_edge.radius_mm",
      "tip_edge.radius_mm"
    ],
    "campaign_signature_fields": [
      "topology_variables",
      "design_vector_order",
      "enabled_features",
      "patch_group_ids"
    ]
  },
  "target_entities": [
    "hub_meridional_profile",
    "blade_tip_meridional_profile",
    "leading_edge_boundary",
    "trailing_edge_boundary",
    "blade_mean_surface",
    "blade_thickness_distribution",
    "leading_edge_transition",
    "trailing_edge_transition",
    "root_transition",
    "tip_transition",
    "hub_material_solid",
    "front_hood_shell",
    "hub_chamfer_features",
    "hood_chamfer_features"
  ],
  "topology_defaults": {
    "hub_profile": {
      "degree": 3,
      "control_point_count": 6,
      "knot_policy": "clamped_open_uniform",
      "weight_policy": "unit_locked"
    },
    "tip_profile": {
      "degree": 3,
      "control_point_count": 6,
      "knot_policy": "clamped_open_uniform",
      "weight_policy": "unit_locked"
    },
    "blade_surface": {
      "guide_curve_count": 3,
      "spanwise_layer_count": 4,
      "knot_policy": "clamped_open_uniform"
    }
  },
  "design_variable_bounds": {
    "root_fillet.radius_mm": {
      "units": "mm",
      "min": 0.0,
      "max": 80.0,
      "maps_to_parameter": "root_fillet_radius_mm"
    },
    "leading_edge.radius_mm": {
      "units": "mm",
      "min": 0.0,
      "max": 200.0,
      "maps_to_parameter": "leading_edge_radius_mm"
    },
    "trailing_edge.radius_mm": {
      "units": "mm",
      "min": 0.0,
      "max": 200.0,
      "maps_to_parameter": "trailing_edge_radius_mm"
    },
    "tip_edge.radius_mm": {
      "units": "mm",
      "min": 0.0,
      "max": 200.0,
      "maps_to_parameter": "tip_edge_radius_mm"
    },
    "blade_theta_control_points[*].theta_deg": {
      "units": "deg",
      "min": -240.0,
      "max": 240.0,
      "maps_to_parameter": "blade_wrap_deg"
    },
    "thickness_control_points[*].thickness_mm": {
      "units": "mm",
      "min": 0.5,
      "max": 120.0,
      "maps_to_parameter": "blade_thickness_mm"
    }
  },
  "policies": {
    "hub_meridional_profile": {
      "target_entity": "hub_meridional_profile",
      "representation": "nurbs_curve_rz",
      "representation_topology": {
        "degree": 3,
        "control_point_count": 6,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "hub_cp_0_r",
          "kind": "control_point_coordinate",
          "coordinate": "r",
          "control_point_index": 0,
          "editable": true,
          "optimizable": true,
          "bounds_mm": [40.0, 260.0]
        },
        {
          "id": "hub_cp_5_r",
          "kind": "control_point_coordinate",
          "coordinate": "r",
          "control_point_index": 5,
          "editable": true,
          "optimizable": true,
          "bounds_mm": [20.0, 180.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "hub_profile_shape",
          "maps_to": ["hub_cp_0_r", "hub_cp_5_r"],
          "intent": "Control the v0.7 hub meridional support profile while preserving the existing runtime-compatible policy shape."
        }
      ],
      "constraints": [
        "radius_positive",
        "hub_profile_base_radius_greater_than_nose_radius",
        "nurbs_knot_vector_non_decreasing",
        "control_net_dimension_matches_degree",
        "hub_tip_profiles_do_not_cross"
      ]
    },
    "blade_tip_meridional_profile": {
      "target_entity": "blade_tip_meridional_profile",
      "representation": "nurbs_curve_rz",
      "representation_topology": {
        "degree": 3,
        "control_point_count": 6,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "tip_cp_0_r",
          "kind": "control_point_coordinate",
          "coordinate": "r",
          "control_point_index": 0,
          "editable": true,
          "optimizable": true,
          "bounds_mm": [80.0, 400.0]
        },
        {
          "id": "tip_cp_5_r",
          "kind": "control_point_coordinate",
          "coordinate": "r",
          "control_point_index": 5,
          "editable": true,
          "optimizable": true,
          "bounds_mm": [180.0, 2000.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "tip_profile_shape",
          "maps_to": ["tip_cp_0_r", "tip_cp_5_r"],
          "intent": "Control the blade-tip or shroud support profile."
        }
      ],
      "constraints": [
        "radius_positive",
        "hub_tip_profiles_do_not_cross",
        "nurbs_knot_vector_non_decreasing",
        "control_net_dimension_matches_degree"
      ]
    },
    "leading_edge_boundary": {
      "target_entity": "leading_edge_boundary",
      "representation": "nurbs_curve_xyz",
      "representation_topology": {
        "degree": 3,
        "control_point_count": 4,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "leading_edge_lean_deg",
          "kind": "semantic_angle",
          "editable": true,
          "optimizable": true,
          "bounds_deg": [-60.0, 60.0]
        },
        {
          "id": "leading_edge_sweep_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [-300.0, 300.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "leading_edge_direction",
          "maps_to": ["leading_edge_lean_deg", "leading_edge_sweep_mm"],
          "intent": "Control the u=0 blade boundary direction between hub and tip supports."
        }
      ],
      "constraints": [
        "leading_edge_boundary_connects_hub_to_tip_support",
        "nurbs_knot_vector_non_decreasing",
        "control_net_dimension_matches_degree"
      ]
    },
    "trailing_edge_boundary": {
      "target_entity": "trailing_edge_boundary",
      "representation": "nurbs_curve_xyz",
      "representation_topology": {
        "degree": 3,
        "control_point_count": 4,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "trailing_edge_lean_deg",
          "kind": "semantic_angle",
          "editable": true,
          "optimizable": true,
          "bounds_deg": [-60.0, 60.0]
        },
        {
          "id": "trailing_edge_sweep_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [-300.0, 300.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "trailing_edge_direction",
          "maps_to": ["trailing_edge_lean_deg", "trailing_edge_sweep_mm"],
          "intent": "Control the u=1 blade boundary direction between hub and tip supports."
        }
      ],
      "constraints": [
        "trailing_edge_boundary_connects_hub_to_tip_support",
        "nurbs_knot_vector_non_decreasing",
        "control_net_dimension_matches_degree"
      ]
    },
    "blade_mean_surface": {
      "target_entity": "blade_mean_surface",
      "representation": "nurbs_surface_uv_xyz",
      "representation_topology": {
        "degree": 3,
        "control_point_count": 24,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "blade_wrap_deg",
          "kind": "semantic_angle",
          "editable": true,
          "optimizable": true,
          "bounds_deg": [-240.0, 240.0]
        },
        {
          "id": "blade_lean_deg",
          "kind": "semantic_angle",
          "editable": true,
          "optimizable": true,
          "bounds_deg": [-60.0, 60.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "blade_wrap",
          "maps_to": ["blade_wrap_deg"],
          "intent": "Control circumferential blade wrapping from leading to trailing edge."
        }
      ],
      "constraints": [
        "blade_root_boundary_conforms_to_hub_support_surface",
        "blade_tip_boundary_conforms_to_blade_tip_support_surface",
        "pressure_suction_surfaces_do_not_swap"
      ]
    },
    "blade_thickness_distribution": {
      "target_entity": "blade_thickness_distribution",
      "representation": "scalar_field_uv",
      "representation_topology": {
        "degree": 2,
        "control_point_count": 9,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "blade_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.5, 120.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "blade_mid_thickness",
          "maps_to": ["blade_thickness_mm"],
          "intent": "Control nominal blade thickness before edge transition shaping."
        }
      ],
      "constraints": [
        "nurbs_weights_positive",
        "leading_edge_thickness_plausibility"
      ]
    },
    "leading_edge_transition": {
      "target_entity": "leading_edge_transition",
      "representation": "nurbs_surface_uv_xyz",
      "representation_topology": {
        "degree": 2,
        "control_point_count": 9,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "leading_edge_radius_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.0, 200.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "leading_edge_radius",
          "maps_to": ["leading_edge_radius_mm"],
          "intent": "Control leading-edge rounded transition radius."
        }
      ],
      "constraints": [
        "transition_surfaces_connect_declared_input_boundaries",
        "blade_has_leading_and_trailing_edge_closures"
      ]
    },
    "trailing_edge_transition": {
      "target_entity": "trailing_edge_transition",
      "representation": "nurbs_surface_uv_xyz",
      "representation_topology": {
        "degree": 2,
        "control_point_count": 9,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "trailing_edge_radius_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.0, 200.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "trailing_edge_radius",
          "maps_to": ["trailing_edge_radius_mm"],
          "intent": "Control trailing-edge rounded transition radius."
        }
      ],
      "constraints": [
        "transition_surfaces_connect_declared_input_boundaries",
        "blade_has_leading_and_trailing_edge_closures"
      ]
    },
    "root_transition": {
      "target_entity": "root_transition",
      "representation": "nurbs_surface_uv_xyz",
      "representation_topology": {
        "degree": 2,
        "control_point_count": 9,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "root_fillet_radius_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.0, 80.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "root_fillet_radius",
          "maps_to": ["root_fillet_radius_mm"],
          "intent": "Control blade-root transition radius into the hub material domain."
        }
      ],
      "constraints": [
        "root_fillet_radius_positive",
        "transition_surfaces_connect_declared_input_boundaries"
      ]
    },
    "tip_transition": {
      "target_entity": "tip_transition",
      "representation": "nurbs_surface_uv_xyz",
      "representation_topology": {
        "degree": 2,
        "control_point_count": 9,
        "knot_policy": "clamped_uniform",
        "weights": "unit"
      },
      "control_variables": [
        {
          "id": "tip_edge_radius_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.0, 200.0]
        }
      ],
      "semantic_handles": [
        {
          "id": "tip_edge_radius",
          "maps_to": ["tip_edge_radius_mm"],
          "intent": "Control blade-tip transition radius."
        }
      ],
      "constraints": [
        "blade_has_root_and_tip_treatment",
        "transition_surfaces_connect_declared_input_boundaries"
      ]
    }
  },
  "material_domain_controls": {
    "hub_material_solid": {
      "control_variables": [
        {
          "id": "hub_wall_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [1.0, 120.0]
        },
        {
          "id": "hub_bottom_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [1.0, 160.0]
        },
        {
          "id": "hub_top_cap_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [1.0, 80.0]
        }
      ],
      "constraints": [
        "hub_wall_thickness_positive",
        "hub_bottom_thickness_positive",
        "hub_top_cap_thickness_positive",
        "mounting_bore_radius_less_than_local_hub_radius"
      ]
    },
    "front_hood_shell": {
      "control_variables": [
        {
          "id": "hood_wall_thickness_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [1.0, 80.0]
        }
      ],
      "constraints": [
        "hood_wall_thickness_positive_for_closed_impeller",
        "hood_shell_inner_outer_surfaces_do_not_cross"
      ]
    },
    "hub_chamfer_features": {
      "control_variables": [
        {
          "id": "hub_chamfer_radius_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.0, 30.0]
        }
      ],
      "constraints": [
        "hub_chamfer_radius_nonnegative",
        "hub_chamfer_does_not_remove_blade_root_boundary"
      ]
    },
    "hood_chamfer_features": {
      "control_variables": [
        {
          "id": "hood_chamfer_radius_mm",
          "kind": "semantic_length",
          "editable": true,
          "optimizable": true,
          "bounds_mm": [0.0, 30.0]
        }
      ],
      "constraints": [
        "hood_chamfer_radius_nonnegative",
        "hood_chamfer_does_not_remove_blade_tip_boundary"
      ]
    }
  },
  "carried_forward_from_v0_3": [
    "hub_meridional_profile",
    "blade_tip_meridional_profile",
    "leading_edge_boundary",
    "trailing_edge_boundary",
    "blade_mean_surface",
    "blade_thickness_distribution",
    "leading_edge_transition",
    "trailing_edge_transition",
    "root_transition",
    "tip_transition",
    "hub_material_solid",
    "front_hood_shell"
  ]
}
